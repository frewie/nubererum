# Basic Auth (the default) for self-hosted LAN deployments: it protects the web app
# itself before it can operate your Things account. Required off loopback (at
# least 16 characters); only read in basic mode, so passkey mode can leave it out.
APP_USERNAME=admin
APP_PASSWORD=change-this-long-random-password

# For internet access, use passkeys instead of Basic Auth (see docs/DEPLOYMENT.md).
# APP_AUTH=passkey
# APP_PUBLIC_ORIGINS=https://things.example.com

# Your Things Cloud credentials. Prefer a dedicated app password if Cultured Code
# provides one in the future; today Things Cloud uses the account password.
THINGS_USERNAME=you@example.com
THINGS_PASSWORD=your-things-cloud-password

# Time zone used to decide which tasks belong in Today.
TZ=Europe/Berlin
