+package thingscloud
+
+import (
+	"encoding/json"
+	"fmt"
+)
+
+// NoRepeatEnd is the rr "ed" Things writes for a rule without an end date
+// (1 January 4001).
+const NoRepeatEnd = 64092211200
+
+var repeatRuleKeys = map[string]struct{}{
+	"rrv": {}, "tp": {}, "fu": {}, "fa": {}, "of": {}, "ia": {}, "sr": {}, "rc": {}, "ts": {}, "ed": {},
+}
+
+// validateRepeatRule accepts the rr shapes Things itself writes for a new
+// rule (observed in an account history of 253,000 items): version 4, a fixed
+// schedule (tp 0) or after completion (tp 1), every fa days (fu 16), weeks
+// (256), months (8) or years (4), one offset in "of", no end and no early
+// start. Day numbers in "of" are 0-based (dy -1 is the last day of the
+// month), weekdays count from Sunday = 0 and months from January = 0.
+func validateRepeatRule(raw json.RawMessage) error {
+	rule, err := jsonObject(raw)
+	if err != nil || exactKeys(rule, repeatRuleKeys) != nil {
+		return fmt.Errorf("must contain exactly the verified rule properties")
+	}
+	want := func(key string, value int64) error {
+		if got, ok := jsonInteger(rule[key]); !ok || got != value {
+			return fmt.Errorf("%s must be %d", key, value)
+		}
+		return nil
+	}
+	for key, value := range map[string]int64{"rrv": 4, "rc": 0, "ts": 0, "ed": NoRepeatEnd} {
+		if err := want(key, value); err != nil {
+			return err
+		}
+	}
+	if tp, ok := jsonInteger(rule["tp"]); !ok || (tp != 0 && tp != 1) {
+		return fmt.Errorf("tp must be 0 or 1")
+	}
+	if fa, ok := jsonInteger(rule["fa"]); !ok || fa < 1 || fa > 99 {
+		return fmt.Errorf("fa must be 1..99")
+	}
+	var days [2]int64
+	for i, key := range []string{"sr", "ia"} {
+		value, ok := jsonInteger(rule[key])
+		if !ok || value <= 0 || value%86400 != 0 {
+			return fmt.Errorf("%s must be a day (midnight UTC)", key)
+		}
+		days[i] = value
+	}
+	if days[1] < days[0] {
+		return fmt.Errorf("ia must not be before sr")
+	}
+	var offsets []map[string]json.RawMessage
+	if json.Unmarshal(rule["of"], &offsets) != nil || len(offsets) != 1 {
+		return fmt.Errorf("of must hold one offset")
+	}
+	offset := offsets[0]
+	in := func(key string, low, high int64) bool {
+		value, ok := jsonInteger(offset[key])
+		return ok && value >= low && value <= high
+	}
+	fu, _ := jsonInteger(rule["fu"])
+	switch {
+	case fu == 16 && len(offset) == 1 && in("dy", 0, 0):
+	case fu == 256 && len(offset) == 1 && in("wd", 0, 6):
+	case fu == 8 && len(offset) == 1 && in("dy", -1, 30):
+	case fu == 8 && len(offset) == 2 && in("wd", 0, 6) && in("wdo", 1, 4):
+	case fu == 4 && len(offset) == 2 && in("dy", 0, 30) && in("mo", 0, 11):
+	default:
+		return fmt.Errorf("of does not match the unit")
+	}
+	return nil
+}
