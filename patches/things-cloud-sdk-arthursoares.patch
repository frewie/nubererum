+// buildBatchDeadline sets (dd) or removes (dd null) a deadline; Things
+// writes dd alone.
+func buildBatchDeadline(op BatchOp) (thingscloud.Identifiable, map[string]string, error) {
+	if op.UUID == "" || op.DeadlineSet == nil {
+		return nil, nil, fmt.Errorf("deadline requires uuid and deadlineDate")
+	}
+	if err := validateBatchOpIdentifiers(op); err != nil {
+		return nil, nil, err
+	}
+	u := newTaskUpdate()
+	if *op.DeadlineSet == "" {
+		u.fields["dd"] = nil
+	} else {
+		t := parseDate(*op.DeadlineSet)
+		if t == nil {
+			return nil, nil, fmt.Errorf("invalid deadline %q", *op.DeadlineSet)
+		}
+		u.Deadline(t.Unix())
+	}
+	env := writeEnvelope{id: op.UUID, action: 1, kind: task7WriteKind, payload: u.build()}
+	return env, map[string]string{"cmd": "deadline", "uuid": op.UUID}, nil
+}
