diff --git a/cmd/things-cli/repeat.go b/cmd/things-cli/repeat.go
new file mode 100644
index 0000000..04a5884
--- /dev/null
+++ b/cmd/things-cli/repeat.go
@@ -0,0 +1,85 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+
+	thingscloud "github.com/arthursoares/things-cloud-sdk"
+)
+
+// RepeatSpec makes a created to-do a repeating template. Start is the first
+// day it is due; the weekday, day of the month or date of the rule follow
+// from it. Month picks the monthly kind: "day" (default), "last" (the start
+// must be the month's last day) or "weekday" (e.g. the first Thursday).
+type RepeatSpec struct {
+	Type  string `json:"type"` // "fixed" or "after" (completion)
+	Unit  string `json:"unit"` // "day", "week", "month" or "year"
+	Every int    `json:"every"`
+	Month string `json:"month,omitempty"`
+	Start string `json:"start"`
+}
+
+var repeatUnits = map[string]int{"day": 16, "week": 256, "month": 8, "year": 4}
+
+// repeatRule builds rr as Things writes a new rule: the rule starts today
+// (sr), its anchor is the first day (ia), no end and no early start.
+func repeatRule(spec RepeatSpec, today time.Time) (json.RawMessage, int64, error) {
+	unit, ok := repeatUnits[spec.Unit]
+	if !ok {
+		return nil, 0, fmt.Errorf("repeat unit must be day, week, month or year")
+	}
+	if spec.Type != "fixed" && spec.Type != "after" {
+		return nil, 0, fmt.Errorf("repeat type must be fixed or after")
+	}
+	if spec.Every < 1 || spec.Every > 99 {
+		return nil, 0, fmt.Errorf("repeat every must be 1..99")
+	}
+	first, err := time.Parse("2006-01-02", spec.Start)
+	if err != nil {
+		return nil, 0, fmt.Errorf("repeat start must be YYYY-MM-DD")
+	}
+	day := time.Date(today.Year(), today.Month(), today.Day(), 0, 0, 0, 0, time.UTC)
+	if first.Before(day) {
+		return nil, 0, fmt.Errorf("repeat start must not be in the past")
+	}
+	var offset map[string]int
+	switch spec.Unit {
+	case "day":
+		offset = map[string]int{"dy": 0}
+	case "week":
+		offset = map[string]int{"wd": int(first.Weekday())}
+	case "month":
+		switch spec.Month {
+		case "", "day":
+			offset = map[string]int{"dy": first.Day() - 1}
+		case "last":
+			if first.AddDate(0, 0, 1).Month() == first.Month() {
+				return nil, 0, fmt.Errorf("repeat start must be the last day of its month")
+			}
+			offset = map[string]int{"dy": -1}
+		case "weekday":
+			nth := (first.Day()-1)/7 + 1
+			if nth > 4 {
+				return nil, 0, fmt.Errorf("repeat start must be in the first four weeks of its month")
+			}
+			offset = map[string]int{"wd": int(first.Weekday()), "wdo": nth}
+		default:
+			return nil, 0, fmt.Errorf("repeat month must be day, last or weekday")
+		}
+	case "year":
+		offset = map[string]int{"dy": first.Day() - 1, "mo": int(first.Month()) - 1}
+	}
+	if spec.Unit != "month" && spec.Month != "" {
+		return nil, 0, fmt.Errorf("repeat month is only for monthly rules")
+	}
+	tp := 0
+	if spec.Type == "after" {
+		tp = 1
+	}
+	rule, _ := json.Marshal(map[string]any{
+		"rrv": 4, "tp": tp, "fu": unit, "fa": spec.Every, "of": []map[string]int{offset},
+		"ia": first.Unix(), "sr": day.Unix(), "rc": 0, "ts": 0, "ed": thingscloud.NoRepeatEnd,
+	})
+	return rule, first.Unix(), nil
+}
diff --git a/cmd/things-cli/serve.go b/cmd/things-cli/serve.go
new file mode 100644
index 0000000..4874ce4
--- /dev/null
+++ b/cmd/things-cli/serve.go
@@ -0,0 +1,137 @@
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	thingscloud "github.com/arthursoares/things-cloud-sdk"
+)
+
+// serve mode keeps one things-cli process running for a host application:
+// it signs in once, keeps the connection to Things Cloud open and the state
+// in memory, and runs one command per input line. Each line is a JSON
+// request {"args":[...],"input":...,"offline":bool}; each answer is one JSON
+// line {"ok":bool,"output":"...","error":"..."}. The first output line is
+// {"ready":true,"protocol":1}.
+
+const serveProtocol = 1
+
+type serveRequest struct {
+	Args []string `json:"args"`
+	// Input is the batch command's stdin.
+	Input json.RawMessage `json:"input,omitempty"`
+	// Offline reads use the state as of the previous command without asking
+	// Things Cloud for changes.
+	Offline bool `json:"offline,omitempty"`
+}
+
+type serveResponse struct {
+	OK     bool   `json:"ok"`
+	Output string `json:"output,omitempty"`
+	Error  string `json:"error,omitempty"`
+}
+
+// serveFailure carries a fatal error out of a command in serve mode.
+type serveFailure string
+
+var (
+	serving bool
+	// commandOut and commandIn replace stdout and stdin while serve mode
+	// runs a command.
+	commandOut io.Writer
+	commandIn  io.Reader
+	// serveState is the state after the last command, serveSnapshot the
+	// cache file content it was read from or saved as.
+	serveState    *cliStateCache
+	serveSnapshot []byte
+	serveOffline  bool
+)
+
+func outputWriter() io.Writer {
+	if commandOut != nil {
+		return commandOut
+	}
+	return os.Stdout
+}
+
+func inputReader() io.Reader {
+	if commandIn != nil {
+		return commandIn
+	}
+	return os.Stdin
+}
+
+func cmdServe() {
+	serving = true
+	// Writes check their targets against the history; keep what was read.
+	thingscloud.KeepPreflightIndex = true
+	out := json.NewEncoder(os.Stdout)
+	_ = out.Encode(map[string]any{"ready": true, "protocol": serveProtocol})
+	in := bufio.NewReader(os.Stdin)
+	var ctx *cliContext
+	for {
+		line, err := in.ReadBytes('\n')
+		if len(bytes.TrimSpace(line)) > 0 {
+			var request serveRequest
+			response := serveResponse{}
+			if jsonErr := json.Unmarshal(line, &request); jsonErr != nil || len(request.Args) == 0 {
+				response.Error = "serve: invalid request"
+			} else {
+				var output bytes.Buffer
+				ctx, response.Error = serveCommand(ctx, request, &output)
+				response.OK = response.Error == ""
+				response.Output = output.String()
+			}
+			if err := out.Encode(response); err != nil {
+				os.Exit(1)
+			}
+		}
+		if err != nil {
+			return
+		}
+	}
+}
+
+// serveCommand runs one request. After a failure the connection and the
+// in-memory state are dropped, so the next command starts clean.
+func serveCommand(ctx *cliContext, request serveRequest, output *bytes.Buffer) (next *cliContext, failure string) {
+	commandOut, commandIn = output, bytes.NewReader(request.Input)
+	serveOffline = request.Offline
+	defer func() {
+		commandOut, commandIn, serveOffline = nil, nil, false
+		if recovered := recover(); recovered != nil {
+			message, ok := recovered.(serveFailure)
+			if !ok {
+				message = serveFailure(fmt.Sprint("internal error: ", recovered))
+			}
+			next, failure = nil, strings.TrimSpace(string(message))
+			serveState, serveSnapshot = nil, nil
+			output.Reset()
+		}
+	}()
+	cmd, args := request.Args[0], request.Args[1:]
+	if cmd == "serve" {
+		fatalf("serve: already serving")
+	}
+	if ctx == nil {
+		ctx = initCLI(false)
+		// Read the history for write checks now, so the first write does
+		// not wait for it. A failure here is repeated by that write.
+		if thingscloud.KeepPreflightIndex {
+			warm := *ctx.history
+			go func() { _ = warm.WarmPreflightIndex() }()
+		}
+	}
+	if commandNeedsHistoryHead(cmd) {
+		if err := ctx.history.Sync(); err != nil {
+			fatal("sync history", err)
+		}
+	}
+	runCommand(ctx, cmd, args)
+	return ctx, ""
+}
