+func TestStateUpdateEveningAndRepeatRule(t *testing.T) {
+	t.Parallel()
+
+	state := NewState()
+	update := func(payload string) *things.Task {
+		t.Helper()
+		if err := state.Update(taskReadItem("evening", task7Kind, things.ItemActionModified, payload)); err != nil {
+			t.Fatalf("Update(%s): %v", payload, err)
+		}
+		return requireTask(t, state, "evening")
+	}
+
+	rule := `{"ed":64092211200,"fa":1,"fu":256,"ia":1700006400,"of":[{"wd":5}],"rc":0,"rrv":4,"sr":1700006400,"tp":0,"ts":0}`
+	task := update(`{"tt":"Plants","st":1,"sr":1700006400,"tir":1700006400,"sb":1,"rr":` + rule + `}`)
+	if !task.Evening {
+		t.Fatal("sb 1 did not set Evening")
+	}
+	if !task.IsRepeatingTemplate || string(task.RepeatRule) != rule {
+		t.Fatalf("RepeatRule = %s, want the rr object as written (incl. rrv)", task.RepeatRule)
+	}
+
+	task = update(`{"tt":"Water plants"}`)
+	if !task.Evening || string(task.RepeatRule) != rule {
+		t.Fatal("omitted sb or rr changed the task")
+	}
+
+	task = update(`{"sb":0}`)
+	if task.Evening {
+		t.Fatal("sb 0 did not clear Evening")
+	}
+	task = update(`{"sb":1}`)
+	task = update(`{"sb":null,"rr":null}`)
+	if task.Evening || task.RepeatRule != nil || task.IsRepeatingTemplate {
+		t.Fatalf("explicit null did not clear sb/rr: evening=%v rule=%s", task.Evening, task.RepeatRule)
+	}
+}
