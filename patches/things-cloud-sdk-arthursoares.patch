+// TestCmdBatchEmptyTrashWire empties the Trash as Things does: per item Task7
+// action 2 {} plus a Tombstone2 {dloid, dld} in the same commit.
+func TestCmdBatchEmptyTrashWire(t *testing.T) {
+	todo, project := thingscloud.NewUUID(), thingscloud.NewUUID()
+	h, commits, _ := newWireRecorder(t)
+	r, w, _ := os.Pipe()
+	origStdin := os.Stdin
+	os.Stdin = r
+	t.Cleanup(func() { os.Stdin = origStdin })
+	go func() {
+		_, _ = fmt.Fprintf(w, `[{"cmd":"delete","uuid":%q},{"cmd":"purge","uuid":%q},{"cmd":"delete","uuid":%q},{"cmd":"purge","uuid":%q}]`, todo, todo, project, project)
+		w.Close()
+	}()
+
+	cmdBatch(h)
+
+	if len(*commits) != 1 {
+		t.Fatalf("%d commits, want 1", len(*commits))
+	}
+	body := (*commits)[0].body
+	if len(body) != 4 {
+		t.Fatalf("%d envelopes, want 4", len(body))
+	}
+	purged := map[string]bool{}
+	for id, item := range body {
+		switch item.E {
+		case "Task7":
+			if item.T != 2 || string(item.P) != "{}" || (id != todo && id != project) {
+				t.Fatalf("delete %s = %d %s", id, item.T, item.P)
+			}
+		case "Tombstone2":
+			var payload struct {
+				Dloid string   `json:"dloid"`
+				Dld   *float64 `json:"dld"`
+			}
+			if err := json.Unmarshal(item.P, &payload); err != nil || item.T != 0 || payload.Dld == nil {
+				t.Fatalf("tombstone %s = %d %s (%v)", id, item.T, item.P, err)
+			}
+			purged[payload.Dloid] = true
+		default:
+			t.Fatalf("unexpected envelope %s %s", id, item.E)
+		}
+	}
+	if !purged[todo] || !purged[project] {
+		t.Fatalf("tombstones for %v, want both items", purged)
+	}
+
+	// A tombstone for an item not deleted in the same commit is refused.
+	other := thingscloud.NewUUID()
+	valid, _, _ := buildBatchEnvelope(BatchOp{Cmd: "delete", UUID: todo})
+	stray, _, _ := buildBatchEnvelope(BatchOp{Cmd: "purge", UUID: other})
+	if err := h.Write(valid, stray); err == nil || !strings.Contains(err.Error(), "not deleted in this commit") {
+		t.Fatalf("stray tombstone write = %v, want refusal", err)
+	}
+}
