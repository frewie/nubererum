+func TestServeKeepsSessionAndState(t *testing.T) {
+	cache, counts := serveTestEnv(t)
+	run := func(ctx *cliContext, request serveRequest) (*cliContext, string) {
+		t.Helper()
+		var output bytes.Buffer
+		next, failure := serveCommand(ctx, request, &output)
+		if failure != "" {
+			t.Fatalf("%v failed: %s", request.Args, failure)
+		}
+		return next, output.String()
+	}
+
+	ctx, out := run(nil, serveRequest{Args: []string{"list"}})
+	if !strings.Contains(out, "seeded") {
+		t.Fatalf("list output = %s", out)
+	}
+	first := counts()
+	if first["account"] == 0 || first["items"] != 1 {
+		t.Fatalf("first list requests = %v", first)
+	}
+	info, err := os.Stat(cache)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Offline reads ask Things Cloud nothing.
+	ctx, _ = run(ctx, serveRequest{Args: []string{"today"}, Offline: true})
+	if got := counts(); fmt.Sprint(got) != fmt.Sprint(first) {
+		t.Fatalf("offline today requests = %v, want %v", got, first)
+	}
+
+	// Later reads reuse the sign-in and skip saving an unchanged state.
+	ctx, out = run(ctx, serveRequest{Args: []string{"list"}})
+	if got := counts(); got["account"] != first["account"] || got["items"] != first["items"] || got["history"] != first["history"]+1 {
+		t.Fatalf("second list requests = %v after %v", got, first)
+	}
+	if !strings.Contains(out, "seeded") {
+		t.Fatalf("second list output = %s", out)
+	}
+	if again, err := os.Stat(cache); err != nil || !again.ModTime().Equal(info.ModTime()) {
+		t.Fatal("unchanged state was saved again")
+	}
+
+	// Writes fetch the history head first, then commit.
+	ctx, out = run(ctx, serveRequest{Args: []string{"batch"}, Input: json.RawMessage(`[{"cmd":"trash","uuid":"VJ1edXTP9q3PmFDUuy8EQh"}]`)})
+	if got := counts(); got["commit"] != 1 || !strings.Contains(out, `"trash"`) {
+		t.Fatalf("batch requests = %v, output %s", got, out)
+	}
+
+	// A failure is reported, and the next command starts clean.
+	var output bytes.Buffer
+	next, failure := serveCommand(ctx, serveRequest{Args: []string{"batch"}, Input: json.RawMessage(`[]`)}, &output)
+	if next != nil || !strings.Contains(failure, "no operations") || serveState != nil || output.Len() != 0 {
+		t.Fatalf("failed batch: ctx %v, failure %q, output %q", next, failure, output.String())
+	}
+	before := counts()["account"]
+	if _, failure := serveCommand(nil, serveRequest{Args: []string{"today"}}, &output); failure != "" {
+		t.Fatalf("today after failure: %s", failure)
+	}
+	if counts()["account"] == before {
+		t.Fatal("no new sign-in after a failure")
+	}
+}
+
+func TestServeLoopAnswersOneLinePerRequest(t *testing.T) {
+	serveTestEnv(t)
+	serving = false
+	inRead, inWrite, _ := os.Pipe()
+	outRead, outWrite, _ := os.Pipe()
+	origIn, origOut := os.Stdin, os.Stdout
+	os.Stdin, os.Stdout = inRead, outWrite
+	t.Cleanup(func() { os.Stdin, os.Stdout = origIn, origOut })
+	go func() {
+		fmt.Fprintln(inWrite, `{"args":["list"]}`)
+		fmt.Fprintln(inWrite, `not json`)
+		fmt.Fprintln(inWrite, `{"args":["serve"]}`)
+		inWrite.Close()
+	}()
+	done := make(chan struct{})
+	go func() {
+		cmdServe()
+		outWrite.Close()
+		close(done)
+	}()
+	lines := bufio.NewScanner(outRead)
+	lines.Buffer(make([]byte, 1<<20), 1<<20)
+	var got []string
+	for lines.Scan() {
+		got = append(got, lines.Text())
+	}
+	<-done
+	if len(got) != 4 || got[0] != `{"protocol":1,"ready":true}` {
+		t.Fatalf("lines = %q", got)
+	}
+	var list, invalid, nested serveResponse
+	for i, target := range []*serveResponse{&list, &invalid, &nested} {
+		if err := json.Unmarshal([]byte(got[i+1]), target); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if !list.OK || !strings.Contains(list.Output, "seeded") {
+		t.Fatalf("list = %+v", list)
+	}
+	if invalid.OK || invalid.Error != "serve: invalid request" || nested.OK || !strings.Contains(nested.Error, "already serving") {
+		t.Fatalf("invalid = %+v, nested = %+v", invalid, nested)
+	}
+}
