+// buildBatchSchedule sets when a to-do is due: a list (today, evening,
+// anytime, someday, inbox) or a start date. It writes st, sr and tir
+// together, as Things does, and sb: 1 for This Evening (Today with sb 1),
+// 0 for everything else, so a to-do leaves This Evening when it moves.
+func buildBatchSchedule(op BatchOp) (thingscloud.Identifiable, map[string]string, error) {
+	if op.UUID == "" || (op.When == "") == (op.StartDate == "") {
+		return nil, nil, fmt.Errorf("schedule requires uuid and either when or startDate")
+	}
+	if err := validateBatchOpIdentifiers(op); err != nil {
+		return nil, nil, err
+	}
+	u := newTaskUpdate()
+	u.fields["sb"] = 0
+	switch op.When {
+	case "today":
+		u.Today()
+	case "evening":
+		u.Today()
+		u.fields["sb"] = 1
+	case "anytime":
+		u.Anytime()
+	case "someday":
+		u.Someday()
+	case "inbox":
+		u.Inbox()
+	case "":
+		t := parseDate(op.StartDate)
+		if t == nil {
+			return nil, nil, fmt.Errorf("invalid start date %q", op.StartDate)
+		}
+		u.ScheduleDate(t.Unix())
+	default:
+		return nil, nil, fmt.Errorf("unsupported when %q", op.When)
+	}
+	env := writeEnvelope{id: op.UUID, action: 1, kind: task7WriteKind, payload: u.build()}
+	return env, map[string]string{"cmd": "schedule", "uuid": op.UUID}, nil
+}
