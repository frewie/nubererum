+// TestCmdBatchCreateRepeatingWire creates repeating templates as Things does:
+// a to-do with rr (version 4, no end, no early start), icsd on the first
+// day, Someday (st 2) and no start date. Day numbers are 0-based, weekdays
+// count from Sunday = 0 and months from January = 0.
+func TestCmdBatchCreateRepeatingWire(t *testing.T) {
+	today := time.Unix(todayMidnightUTC(), 0).UTC()
+	// 2030-05-02 is a Thursday in the first week of May; 2030-01-31 the last
+	// day of January.
+	cases := []struct {
+		name   string
+		repeat string
+		tp, fu int
+		fa     int
+		of     string
+		first  string
+	}{
+		{"daily", `{"type":"fixed","unit":"day","every":1,"start":"2030-05-02"}`, 0, 16, 1, `[{"dy":0}]`, "2030-05-02"},
+		{"every 2 weeks", `{"type":"fixed","unit":"week","every":2,"start":"2030-05-02"}`, 0, 256, 2, `[{"wd":4}]`, "2030-05-02"},
+		{"monthly by day", `{"type":"fixed","unit":"month","every":1,"start":"2030-05-02"}`, 0, 8, 1, `[{"dy":1}]`, "2030-05-02"},
+		{"monthly last day", `{"type":"fixed","unit":"month","every":1,"month":"last","start":"2030-01-31"}`, 0, 8, 1, `[{"dy":-1}]`, "2030-01-31"},
+		{"first Thursday", `{"type":"fixed","unit":"month","every":1,"month":"weekday","start":"2030-05-02"}`, 0, 8, 1, `[{"wd":4,"wdo":1}]`, "2030-05-02"},
+		{"yearly", `{"type":"fixed","unit":"year","every":1,"start":"2030-05-02"}`, 0, 4, 1, `[{"dy":1,"mo":4}]`, "2030-05-02"},
+		{"after completion", `{"type":"after","unit":"week","every":1,"start":"2030-05-02"}`, 1, 256, 1, `[{"wd":4}]`, "2030-05-02"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			h, commits, _ := newWireRecorder(t)
+			r, w, _ := os.Pipe()
+			origStdin := os.Stdin
+			os.Stdin = r
+			t.Cleanup(func() { os.Stdin = origStdin })
+			id := thingscloud.NewUUID()
+			go func() {
+				_, _ = fmt.Fprintf(w, `[{"cmd":"create","uuid":%q,"title":"Water plants","repeat":%s}]`, id, c.repeat)
+				w.Close()
+			}()
+
+			cmdBatch(h)
+
+			if len(*commits) != 1 {
+				t.Fatalf("%d commits, want 1", len(*commits))
+			}
+			created := (*commits)[0].body[id]
+			var p map[string]json.RawMessage
+			if err := json.Unmarshal(created.P, &p); err != nil || created.E != "Task7" || created.T != 0 {
+				t.Fatalf("create = %s/%d %s", created.E, created.T, created.P)
+			}
+			first, _ := time.Parse("2006-01-02", c.first)
+			if string(p["icsd"]) != fmt.Sprint(first.Unix()) || string(p["st"]) != "2" || string(p["sr"]) != "null" || string(p["tir"]) != "null" || string(p["rt"]) != "[]" || string(p["acrd"]) != "null" {
+				t.Fatalf("template fields icsd=%s st=%s sr=%s tir=%s rt=%s acrd=%s", p["icsd"], p["st"], p["sr"], p["tir"], p["rt"], p["acrd"])
+			}
+			var rr map[string]json.RawMessage
+			_ = json.Unmarshal(p["rr"], &rr)
+			want := map[string]string{
+				"rrv": "4", "tp": fmt.Sprint(c.tp), "fu": fmt.Sprint(c.fu), "fa": fmt.Sprint(c.fa), "of": c.of,
+				"ia": fmt.Sprint(first.Unix()), "sr": fmt.Sprint(today.Unix()), "rc": "0", "ts": "0", "ed": "64092211200",
+			}
+			if len(rr) != len(want) {
+				t.Fatalf("rr = %s", p["rr"])
+			}
+			for key, value := range want {
+				if string(rr[key]) != value {
+					t.Fatalf("rr %s = %s, want %s (%s)", key, rr[key], value, p["rr"])
+				}
+			}
+		})
+	}
+
+	for name, repeat := range map[string]RepeatSpec{
+		"past start":        {Type: "fixed", Unit: "day", Every: 1, Start: today.AddDate(0, 0, -1).Format("2006-01-02")},
+		"unknown unit":      {Type: "fixed", Unit: "hour", Every: 1, Start: "2030-05-02"},
+		"unknown type":      {Type: "sometimes", Unit: "day", Every: 1, Start: "2030-05-02"},
+		"every 0":           {Type: "fixed", Unit: "day", Every: 0, Start: "2030-05-02"},
+		"last, not last":    {Type: "fixed", Unit: "month", Every: 1, Month: "last", Start: "2030-05-02"},
+		"fifth weekday":     {Type: "fixed", Unit: "month", Every: 1, Month: "weekday", Start: "2030-05-30"},
+		"month kind weekly": {Type: "fixed", Unit: "week", Every: 1, Month: "last", Start: "2030-05-02"},
+	} {
+		if _, _, err := buildBatchEnvelope(BatchOp{Cmd: "create", Title: "x", Repeat: &repeat}); err == nil {
+			t.Fatalf("%s accepted", name)
+		}
+	}
+	spec := RepeatSpec{Type: "fixed", Unit: "day", Every: 1, Start: "2030-05-02"}
+	if _, _, err := buildBatchEnvelope(BatchOp{Cmd: "create", Title: "x", When: "today", Repeat: &spec}); err == nil {
+		t.Fatal("repeat with when accepted")
+	}
+	if _, _, err := buildBatchEnvelope(BatchOp{Cmd: "trash", UUID: thingscloud.NewUUID(), Repeat: &spec}); err == nil {
+		t.Fatal("repeat outside create accepted")
+	}
+}
