+// the write check and compares them with what Things writes.
+func TestCmdBatchDatesTagsHeadingAreaWire(t *testing.T) {
+	ids := make([]string, 8)
+	for i := range ids {
+		ids[i] = thingscloud.NewUUID()
+	}
+	heading, tag, area, renamed, tagged, untagged := thingscloud.NewUUID(), thingscloud.NewUUID(), thingscloud.NewUUID(), thingscloud.NewUUID(), thingscloud.NewUUID(), thingscloud.NewUUID()
+	h, commits, _ := newWireRecorder(t, ids...)
+	ops := fmt.Sprintf(`[
+		{"cmd":"schedule","uuid":%q,"when":"someday"},
+		{"cmd":"schedule","uuid":%q,"startDate":"2099-03-04"},
+		{"cmd":"deadline","uuid":%q,"deadlineDate":"2099-05-06"},
+		{"cmd":"deadline","uuid":%q,"deadlineDate":""},
+		{"cmd":"tags","uuid":%q,"tags":[%q]},
+		{"cmd":"move","uuid":%q,"heading":%q},
+		{"cmd":"area-reorder","uuid":%q,"index":-40},
+		{"cmd":"area-rename","uuid":%q,"title":" Garden "},
+		{"cmd":"area-tags","uuid":%q,"tags":[%q]},
+		{"cmd":"area-tags","uuid":%q,"tags":[]},
+		{"cmd":"schedule","uuid":%q,"when":"evening"},
+		{"cmd":"schedule","uuid":%q,"when":"today"}
+	]`, ids[0], ids[1], ids[2], ids[3], ids[4], tag, ids[5], heading, area, renamed, tagged, tag, untagged, ids[6], ids[7])
+	r, w, _ := os.Pipe()
+	origStdin := os.Stdin
+	os.Stdin = r
+	t.Cleanup(func() { os.Stdin = origStdin })
+	go func() { _, _ = w.WriteString(ops); w.Close() }()
+
+	cmdBatch(h)
+
+	body := (*commits)[0].body
+	payload := func(id string) map[string]any {
+		var p map[string]any
+		if err := json.Unmarshal(body[id].P, &p); err != nil {
+			t.Fatal(err)
+		}
+		return p
+	}
+	if p := payload(ids[0]); p["st"] != float64(2) || p["sr"] != nil || p["tir"] != nil || p["sb"] != float64(0) {
+		t.Fatalf("someday = %v", p)
+	}
+	// This Evening as Things writes it: Today (st 1, sr = tir = today) with
+	// sb 1; back to Today with sb 0.
+	today := float64(todayMidnightUTC())
+	if p := payload(ids[6]); p["st"] != float64(1) || p["sr"] != today || p["tir"] != today || p["sb"] != float64(1) {
+		t.Fatalf("evening = %v", p)
+	}
+	if p := payload(ids[7]); p["st"] != float64(1) || p["sr"] != today || p["sb"] != float64(0) {
+		t.Fatalf("today = %v", p)
+	}
+	want := float64(time.Date(2099, 3, 4, 0, 0, 0, 0, time.UTC).Unix())
+	if p := payload(ids[1]); p["st"] != float64(2) || p["sr"] != want || p["tir"] != want {
+		t.Fatalf("scheduled = %v", p)
+	}
+	if p := payload(ids[2]); p["dd"] != float64(time.Date(2099, 5, 6, 0, 0, 0, 0, time.UTC).Unix()) || len(p) != 2 {
+		t.Fatalf("deadline = %v", p)
+	}
+	if p := payload(ids[3]); p["dd"] != nil || len(p) != 2 {
+		t.Fatalf("no deadline = %v", p)
+	}
+	if p := payload(ids[4]); len(p["tg"].([]any)) != 1 || p["tg"].([]any)[0] != tag || len(p) != 2 {
+		t.Fatalf("tags = %v", p)
+	}
+	if p := payload(ids[5]); p["agr"].([]any)[0] != heading || len(p["pr"].([]any)) != 0 || len(p["ar"].([]any)) != 0 {
+		t.Fatalf("heading move = %v", p)
+	}
+	if body[area].E != "Area3" || body[area].T != 1 {
+		t.Fatalf("area reorder envelope = %s/%d", body[area].E, body[area].T)
+	}
+	if p := payload(renamed); body[renamed].E != "Area3" || body[renamed].T != 1 || p["tt"] != "Garden" || len(p) != 1 {
+		t.Fatalf("area rename = %s/%d %v", body[renamed].E, body[renamed].T, p)
+	}
+	// Things writes area tags as tg alone on Area3.
+	if p := payload(tagged); body[tagged].E != "Area3" || body[tagged].T != 1 || len(p) != 1 || len(p["tg"].([]any)) != 1 || p["tg"].([]any)[0] != tag {
+		t.Fatalf("area tags = %s/%d %v", body[tagged].E, body[tagged].T, p)
+	}
+	if p := payload(untagged); len(p) != 1 || len(p["tg"].([]any)) != 0 {
+		t.Fatalf("no area tags = %v", p)
+	}
+	for _, op := range []BatchOp{
+		{Cmd: "schedule", UUID: ids[0]},
+		{Cmd: "schedule", UUID: ids[0], When: "today", StartDate: "2099-01-01"},
+		{Cmd: "schedule", UUID: ids[0], When: "tomorrow"},
+		{Cmd: "deadline", UUID: ids[0]},
+		{Cmd: "move", UUID: ids[0], Heading: heading, Project: heading},
+		{Cmd: "area-reorder", UUID: area},
+		{Cmd: "area-rename", UUID: area, Title: " "},
+		{Cmd: "area-tags"},
+		{Cmd: "area-tags", UUID: area, Tags: []string{"--x"}},
+	} {
+		if _, _, err := buildBatchEnvelope(op); err == nil {
+			t.Fatalf("%+v accepted", op)
+		}
+	}
+}
