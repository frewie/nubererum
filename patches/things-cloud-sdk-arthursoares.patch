+// Repeating to-dos as Things writes them: the template carries the rule (rr)
+// and its instance bookkeeping (icsd, acrd); each instance names the template
+// in rt. Instances take every verified change; templates only a new title,
+// notes and trash.
+func TestHistoryWriteRepeatingInstancesAndTemplates(t *testing.T) {
+	template, instance := NewUUID(), NewUUID()
+	rule := `{"ed":64092211200,"fa":0,"fu":16,"ia":1770000000,"of":[{"wd":1}],"rc":0,"rrv":4,"sr":1770000000,"tp":0,"ts":0}`
+	history := []string{
+		taskHistoryBatch(template, ItemKindTask7, 0, `{"rr":`+rule+`,"rp":null,"rt":[],"icsd":1770000000,"acrd":null}`),
+		taskHistoryBatch(template, ItemKindTask7, 1, `{"icc":1,"icsd":1770600000}`),
+		taskHistoryBatch(instance, ItemKindTask7, 0, `{"rr":null,"rp":null,"rt":["`+template+`"]}`),
+	}
+	note := fmt.Sprintf(`"nt":{"_t":"tx","ch":%d,"t":1,"v":"new"}`, crc32.ChecksumIEEE([]byte("new")))
+	tests := []struct {
+		name   string
+		target string
+		fields string
+		wantOK bool
+	}{
+		{"complete instance", instance, `"ss":3,"sp":1770000002`, true},
+		{"reschedule instance", instance, `"st":1,"sr":1770076800,"tir":1770076800`, true},
+		{"move instance", instance, `"pr":["` + NewUUID() + `"]`, true},
+		{"deadline on instance", instance, `"dd":1770076800`, true},
+		{"trash instance", instance, `"tr":true`, true},
+		{"rename template", template, `"tt":"renamed"`, true},
+		{"notes on template", template, note, true},
+		{"trash template", template, `"tr":true`, true},
+		{"restore template", template, `"tr":false`, true},
+		{"complete template", template, `"ss":3,"sp":1770000002`, false},
+		{"reschedule template", template, `"st":1,"sr":1770076800,"tir":1770076800`, false},
+		{"deadline on template", template, `"dd":1770076800`, false},
+		{"move template", template, `"pr":["` + NewUUID() + `"]`, false},
+		{"rename and reschedule template", template, `"tt":"x","st":2,"sr":null,"tir":null`, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			posts := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method == http.MethodPost {
+					posts++
+					fmt.Fprint(w, `{"server-head-index":4}`)
+					return
+				}
+				fmt.Fprint(w, historyPage(len(history), history...))
+			}))
+			defer server.Close()
+			h := New(server.URL, "test@example.com", "password").HistoryWithID("history")
+			err := h.Write(rawWriteProbe{id: tt.target, body: task7UpdateBody(tt.fields)})
+			if tt.wantOK && (err != nil || posts != 1) {
+				t.Fatalf("Write() = %v, posts %d; want one POST", err, posts)
+			}
+			if !tt.wantOK {
+				if err == nil || !strings.Contains(err.Error(), "repeating template") || posts != 0 {
+					t.Fatalf("Write() = %v, posts %d; want the template refusal before any POST", err, posts)
+				}
+			}
+		})
+	}
+}
