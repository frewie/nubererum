+// buildBatchReminder sets a reminder as Things writes it: ato, the seconds
+// after midnight, with the start date it rings on ({md, ato, st, sr, tir});
+// an empty time removes it (ato null).
+func buildBatchReminder(op BatchOp) (thingscloud.Identifiable, map[string]string, error) {
+	if op.UUID == "" || op.Time == nil {
+		return nil, nil, fmt.Errorf("reminder requires uuid and time")
+	}
+	if err := validateBatchOpIdentifiers(op); err != nil {
+		return nil, nil, err
+	}
+	u := newTaskUpdate()
+	if *op.Time == "" {
+		u.fields["ato"] = nil
+	} else {
+		clock, err := time.Parse("15:04", *op.Time)
+		if err != nil {
+			return nil, nil, fmt.Errorf("invalid reminder time %q", *op.Time)
+		}
+		day := parseDate(op.StartDate)
+		if day == nil {
+			return nil, nil, fmt.Errorf("a reminder needs a start date")
+		}
+		u.ScheduleDate(day.Unix())
+		u.fields["ato"] = clock.Hour()*3600 + clock.Minute()*60
+	}
+	env := writeEnvelope{id: op.UUID, action: 1, kind: task7WriteKind, payload: u.build()}
+	return env, map[string]string{"cmd": "reminder", "uuid": op.UUID}, nil
+}
