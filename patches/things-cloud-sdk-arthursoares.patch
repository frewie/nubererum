+// The cache the CLI writes is the JSON of the state; a replay from it keeps
+// Evening and RepeatRule, and a task without them has neither key.
+func TestStateEveningAndRepeatRuleSurviveJSON(t *testing.T) {
+	t.Parallel()
+
+	state := NewState()
+	rule := `{"fa":2,"fu":16,"of":[{"dy":0}],"tp":1}`
+	if err := state.Update(
+		taskReadItem("a", task7Kind, things.ItemActionCreated, `{"tt":"A","sb":1,"rr":`+rule+`}`),
+		taskReadItem("b", task7Kind, things.ItemActionCreated, `{"tt":"B","sb":0,"rr":null}`),
+	); err != nil {
+		t.Fatal(err)
+	}
+	data, err := json.Marshal(state)
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored := NewState()
+	if err := json.Unmarshal(data, restored); err != nil {
+		t.Fatal(err)
+	}
+	a, b := requireTask(t, restored, "a"), requireTask(t, restored, "b")
+	if !a.Evening || string(a.RepeatRule) != rule || b.Evening || b.RepeatRule != nil {
+		t.Fatalf("after JSON: a evening=%v rule=%s, b evening=%v rule=%s", a.Evening, a.RepeatRule, b.Evening, b.RepeatRule)
+	}
+	var raw struct {
+		Tasks map[string]map[string]json.RawMessage
+	}
+	if err := json.Unmarshal(data, &raw); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := raw.Tasks["b"]["RepeatRule"]; ok {
+		t.Fatal("a task without a rule wrote RepeatRule")
+	}
+}
