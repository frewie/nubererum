+// buildBatchMove puts a to-do into a project or area and leaves its schedule
+// alone, as Things does when a to-do is dragged onto a project (it writes pr,
+// ar and agr only). move-to-project and move-to-area also make it Anytime.
+func buildBatchMove(op BatchOp) (thingscloud.Identifiable, map[string]string, error) {
+	targets := 0
+	for _, target := range []string{op.Project, op.Area, op.Heading} {
+		if target != "" {
+			targets++
+		}
+	}
+	if op.UUID == "" || targets != 1 {
+		return nil, nil, fmt.Errorf("move requires uuid and one of project, area or heading")
+	}
+	if err := validateBatchOpIdentifiers(op); err != nil {
+		return nil, nil, err
+	}
+	u := newTaskUpdate()
+	switch {
+	case op.Project != "":
+		u.Project(op.Project)
+	case op.Area != "":
+		u.Area(op.Area)
+	default:
+		// Under a heading the project comes from the heading: Things writes
+		// agr with empty pr and ar.
+		u.Heading(op.Heading)
+		u.fields["pr"] = []string{}
+		u.fields["ar"] = []string{}
+	}
+	env := writeEnvelope{id: op.UUID, action: 1, kind: task7WriteKind, payload: u.build()}
+	return env, map[string]string{"cmd": "move", "uuid": op.UUID}, nil
+}
