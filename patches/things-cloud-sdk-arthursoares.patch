+// buildBatchCancel cancels a to-do as Things does: ss 2 with the time (sp).
+// It stays in its list until "Log Completed"; reopen undoes it.
+func buildBatchCancel(op BatchOp) (thingscloud.Identifiable, map[string]string, error) {
+	if op.UUID == "" {
+		return nil, nil, fmt.Errorf("cancel requires uuid")
+	}
+	if err := validateBatchOpIdentifiers(op); err != nil {
+		return nil, nil, err
+	}
+	u := newTaskUpdate().Status(2).StopDate(nowTs())
+	env := writeEnvelope{id: op.UUID, action: 1, kind: task7WriteKind, payload: u.build()}
+	return env, map[string]string{"cmd": "cancel", "uuid": op.UUID}, nil
+}
