+func TestValidateRepeatRule(t *testing.T) {
+	rule := func(change string) json.RawMessage {
+		base := `"rrv":4,"tp":0,"fu":256,"fa":1,"ia":1904256000,"sr":1904256000,"rc":0,"ts":0,"ed":64092211200`
+		if change == "" {
+			change = `"of":[{"wd":4}]`
+		}
+		return json.RawMessage("{" + base + "," + change + "}")
+	}
+	if err := validateRepeatRule(rule("")); err != nil {
+		t.Fatalf("weekly rule rejected: %v", err)
+	}
+	for name, raw := range map[string]json.RawMessage{
+		"two offsets":      rule(`"of":[{"wd":4},{"wd":5}]`),
+		"weekday 7":        rule(`"of":[{"wd":7}]`),
+		"day for weekly":   rule(`"of":[{"dy":3}]`),
+		"extra key":        rule(`"of":[{"wd":4}],"xx":1`),
+		"version 3":        json.RawMessage(`{"rrv":3,"tp":0,"fu":256,"fa":1,"of":[{"wd":4}],"ia":1904256000,"sr":1904256000,"rc":0,"ts":0,"ed":64092211200}`),
+		"early start":      json.RawMessage(`{"rrv":4,"tp":0,"fu":256,"fa":1,"of":[{"wd":4}],"ia":1904256000,"sr":1904256000,"rc":0,"ts":-3,"ed":64092211200}`),
+		"end date":         json.RawMessage(`{"rrv":4,"tp":0,"fu":256,"fa":1,"of":[{"wd":4}],"ia":1904256000,"sr":1904256000,"rc":0,"ts":0,"ed":1904256000}`),
+		"anchor before sr": json.RawMessage(`{"rrv":4,"tp":0,"fu":256,"fa":1,"of":[{"wd":4}],"ia":1904169600,"sr":1904256000,"rc":0,"ts":0,"ed":64092211200}`),
+		"not midnight":     json.RawMessage(`{"rrv":4,"tp":0,"fu":256,"fa":1,"of":[{"wd":4}],"ia":1904256001,"sr":1904256000,"rc":0,"ts":0,"ed":64092211200}`),
+		"not an object":    json.RawMessage(`true`),
+	} {
+		if err := validateRepeatRule(raw); err == nil {
+			t.Fatalf("%s accepted", name)
+		}
+	}
+}
