+func TestStateUpdateTask2AndTag2UseDerivedIdentifiers(t *testing.T) {
+	t.Parallel()
+
+	const (
+		legacyTaskID = "AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE"
+		legacyTagID  = "44444444-5555-6666-7777-888888888888"
+	)
+	taskID := things.EncodeLegacyIdentifier(legacyTaskID)
+	tagID := things.EncodeLegacyIdentifier(legacyTagID)
+
+	state := NewState()
+	err := state.Update(
+		things.Item{UUID: legacyTagID, Kind: things.ItemKindTag2, Action: things.ItemActionCreated, P: []byte(`{"tt":"Errand"}`)},
+		taskReadItem(legacyTaskID, things.ItemKindTask2, things.ItemActionCreated, `{"tt":"Old task","st":1,"tp":0,"tg":["`+legacyTagID+`"]}`),
+		taskReadItem(taskID, task7Kind, things.ItemActionModified, `{"tt":"Renamed"}`),
+	)
+	if err != nil {
+		t.Fatalf("Update: %v", err)
+	}
+	if len(state.Tasks) != 1 {
+		t.Fatalf("got %d tasks, want the Task2 and Task7 events to share one task", len(state.Tasks))
+	}
+	task := requireTask(t, state, taskID)
+	if task.Title != "Renamed" || len(task.TagIDs) != 1 || task.TagIDs[0] != tagID {
+		t.Fatalf("task = title %q, tags %v; want Renamed with tag %s", task.Title, task.TagIDs, tagID)
+	}
+	if tag := state.Tags[tagID]; tag == nil || tag.Title != "Errand" {
+		t.Fatalf("Tag2 not stored under derived identifier: %+v", state.Tags)
+	}
+}
+
+func TestStateUpdateRepeatingTemplateAndTodayReferenceDate(t *testing.T) {
+	t.Parallel()
+
+	state := NewState()
+	update := func(payload string) *things.Task {
+		t.Helper()
+		if err := state.Update(taskReadItem("repeat", task7Kind, things.ItemActionModified, payload)); err != nil {
+			t.Fatalf("Update(%s): %v", payload, err)
+		}
+		return requireTask(t, state, "repeat")
+	}
+
+	task := update(`{"tt":"Water plants","st":1,"tir":1700006400,"rr":{"tp":0,"fu":16,"fa":1,"of":[{"dy":0}],"sr":1700006400,"ia":1700006400,"rc":0,"ts":0,"ed":64092211200}}`)
+	if !task.IsRepeatingTemplate {
+		t.Fatal("rr object did not mark a repeating template")
+	}
+	want := time.Unix(1700006400, 0).UTC()
+	if task.TodayIndexReferenceDate == nil || !task.TodayIndexReferenceDate.Equal(want) {
+		t.Fatalf("TodayIndexReferenceDate = %v, want %v", task.TodayIndexReferenceDate, want)
+	}
+
+	task = update(`{"tt":"Water the plants"}`)
+	if !task.IsRepeatingTemplate || task.TodayIndexReferenceDate == nil {
+		t.Fatal("omitted rr or tir changed the task")
+	}
+
+	task = update(`{"rr":null,"tir":null}`)
+	if task.IsRepeatingTemplate || task.TodayIndexReferenceDate != nil {
+		t.Fatalf("explicit null did not clear rr/tir: repeating=%v tir=%v", task.IsRepeatingTemplate, task.TodayIndexReferenceDate)
+	}
+}
