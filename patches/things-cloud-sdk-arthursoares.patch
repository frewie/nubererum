+)
+
+// serveCloud is a fake Things Cloud that counts requests by kind.
+func serveCloud(t *testing.T) (*httptest.Server, func() map[string]int) {
+	t.Helper()
+	var mu sync.Mutex
+	counts := map[string]int{}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		mu.Lock()
+		defer mu.Unlock()
+		switch {
+		case strings.Contains(r.URL.Path, "/commit"):
+			counts["commit"]++
+			fmt.Fprint(w, `{"server-head-index":2}`)
+		case strings.HasSuffix(r.URL.Path, "/items"):
+			counts["items"]++
+			if r.URL.Query().Get("start-index") == "0" {
+				fmt.Fprint(w, `{"items":[{"VJ1edXTP9q3PmFDUuy8EQh":{"e":"Task7","t":0,"p":{"tt":"seeded","tp":0,"st":1,"ss":0,"rr":null,"rp":null,"rt":[]}}}],"current-item-index":1,"schema":301}`)
+			} else {
+				fmt.Fprint(w, `{"items":[],"current-item-index":1,"schema":301}`)
+			}
+		case strings.Contains(r.URL.Path, "/version/1/history/"):
+			counts["history"]++
+			fmt.Fprint(w, `{"latest-server-index":1,"latest-schema-version":301}`)
+		case strings.Contains(r.URL.Path, "/account/"):
+			counts["account"]++
+			fmt.Fprint(w, `{"email":"t@example.com","status":"SYAccountStatusActive","history-key":"hist-1"}`)
+		default:
+			fmt.Fprint(w, `{}`)
+		}
+	}))
+	t.Cleanup(server.Close)
+	return server, func() map[string]int {
+		mu.Lock()
+		defer mu.Unlock()
+		snapshot := map[string]int{}
+		for key, value := range counts {
+			snapshot[key] = value
+		}
+		return snapshot
+	}
+}
