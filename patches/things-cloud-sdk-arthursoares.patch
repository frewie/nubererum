+package thingscloud
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/rand"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// fakeHistory serves a growing list of history entries in small pages and
+// counts the entries it sent.
+type fakeHistory struct {
+	mu      sync.Mutex
+	entries []map[string]any
+	served  int
+}
+
+func (f *fakeHistory) set(entries []map[string]any) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.entries = entries
+}
+
+func (f *fakeHistory) sent() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.served
+}
+
+func (f *fakeHistory) server(t *testing.T) *httptest.Server {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		start, _ := strconv.Atoi(r.URL.Query().Get("start-index"))
+		end := min(start+3, len(f.entries))
+		page := []map[string]any{}
+		if start < end {
+			page = f.entries[start:end]
+		}
+		f.served += len(page)
+		_ = json.NewEncoder(w).Encode(map[string]any{"items": page, "current-item-index": len(f.entries)})
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+
+// randomHistory builds entries that exercise the preflight rules: creations,
+// changes and deletions, recurrence markers, tombstones, two items in one
+// entry, unknown kinds and malformed payloads.
+func randomHistory(rng *rand.Rand, ids []string, length int) []map[string]any {
+	payloads := []string{
+		`{}`,
+		`{"rr":null,"rp":null,"rt":[]}`,
+		`{"rr":null,"rp":null,"rt":[],"tt":"x"}`,
+		`{"rr":{"fu":16},"rp":null,"rt":[]}`,
+		`{"rr":{"fu":16},"rp":null,"rt":[],"icsd":1700000000,"acrd":null}`,
+		`{"icc":1,"icsd":1700000000}`,
+		`{"rr":null,"rp":null,"rt":["` + ids[1] + `"]}`,
+		`{"rt":["` + ids[0] + `"]}`,
+		`{"rt":null}`,
+		`{"rp":null}`,
+		`{"icsd":1700000000}`,
+		`{"icsd":null}`,
+		`{"acrd":1700000000}`,
+		`{"rt":"bad"}`,
+		`[]`,
+	}
+	kinds := []string{"Task6", "Task7", "Task6", "Task7", "Task3", "Task9", "Area3"}
+	entries := make([]map[string]any, 0, length)
+	for range length {
+		entry := map[string]any{}
+		id := ids[rng.Intn(len(ids))]
+		entry[id] = map[string]any{
+			"e": kinds[rng.Intn(len(kinds))],
+			"t": rng.Intn(4),
+			"p": json.RawMessage(payloads[rng.Intn(len(payloads))]),
+		}
+		switch rng.Intn(6) {
+		case 0:
+			// A tombstone for another item. (For the entry's own item the SDK's
+			// result depends on the order it reads the entry's map in; see
+			// TestKeptPreflightIndexTombstoneAtTargetsFirstIndex.)
+			if target := ids[rng.Intn(len(ids))]; target != id {
+				entry[NewUUID()] = map[string]any{"e": "Tombstone2", "t": 0, "p": map[string]any{"dloid": target, "dld": 1700000000.5}}
+			}
+		case 1:
+			other := ids[rng.Intn(len(ids))]
+			if other != id {
+				entry[other] = map[string]any{"e": "Task6", "t": 1, "p": json.RawMessage(payloads[rng.Intn(3)])}
+			}
+		}
+		entries = append(entries, entry)
+	}
+	return entries
+}
+
+func preflightResult(h *History, id string) string {
+	return preflightResultKeys(h, id, nil)
+}
+
+// preflightResultKeys checks a modification of id that writes keys.
+func preflightResultKeys(h *History, id string, keys map[string]struct{}) string {
+	var planned map[string]map[string]struct{}
+	if keys != nil {
+		planned = map[string]map[string]struct{}{id: keys}
+	}
+	head, err := h.preflightTask7Modifications(map[string]struct{}{id: {}}, planned)
+	if err != nil {
+		return "error: " + err.Error()
+	}
+	return fmt.Sprint("head ", head)
+}
+
+func resetPreflightIndex(t *testing.T, keep bool) {
+	t.Helper()
+	preflightMu.Lock()
+	preflightCache = nil
+	preflightMu.Unlock()
+	KeepPreflightIndex = keep
+	t.Cleanup(func() {
+		KeepPreflightIndex = false
+		preflightMu.Lock()
+		preflightCache = nil
+		preflightMu.Unlock()
+	})
+}
+
+// preflightKeySets are the writes the random comparison checks: unknown
+// keys, a rename (allowed on templates) and a reschedule (not allowed).
+var preflightKeySets = []map[string]struct{}{
+	nil,
+	{"md": {}, "tt": {}},
+	{"md": {}, "st": {}, "sr": {}, "tir": {}},
+}
+
+// TestKeptPreflightIndexMatchesFullScan grows random histories step by step
+// and checks that a kept index gives the full scan's answer for every item.
+func TestKeptPreflightIndexMatchesFullScan(t *testing.T) {
+	ids := make([]string, 6)
+	for i := range ids {
+		ids[i] = NewUUID()
+	}
+	for seed := int64(1); seed <= 60; seed++ {
+		rng := rand.New(rand.NewSource(seed))
+		all := randomHistory(rng, ids, 40)
+		fake := &fakeHistory{}
+		server := fake.server(t)
+		h := &History{Client: New(server.URL, "test@example.com", "pw"), ID: "history-" + strconv.FormatInt(seed, 10)}
+		resetPreflightIndex(t, true)
+		for length := 0; length <= len(all); length += 1 + rng.Intn(9) {
+			fake.set(all[:length])
+			for _, id := range ids {
+				for _, keys := range preflightKeySets {
+					KeepPreflightIndex = false
+					full := preflightResultKeys(h, id, keys)
+					KeepPreflightIndex = true
+					kept := preflightResultKeys(h, id, keys)
+					if full != kept {
+						t.Fatalf("seed %d, %d entries, %s, keys %v: full scan %q, kept index %q", seed, length, id, keys, full, kept)
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestKeptPreflightIndexReadsOnlyNewItems(t *testing.T) {
+	id := NewUUID()
+	created := map[string]any{"e": "Task7", "t": 0, "p": json.RawMessage(`{"rr":null,"rp":null,"rt":[]}`)}
+	entries := []map[string]any{{id: created}}
+	for range 20 {
+		entries = append(entries, map[string]any{NewUUID(): created})
+	}
+	fake := &fakeHistory{}
+	fake.set(entries)
+	server := fake.server(t)
+	h := &History{Client: New(server.URL, "test@example.com", "pw"), ID: "history"}
+	resetPreflightIndex(t, true)
+
+	if err := h.WarmPreflightIndex(); err != nil {
+		t.Fatal(err)
+	}
+	if fake.sent() != 21 {
+		t.Fatalf("warm-up read %d entries, want 21", fake.sent())
+	}
+	if got := preflightResult(h, id); got != "head 21" {
+		t.Fatalf("preflight = %s", got)
+	}
+	if fake.sent() != 21 {
+		t.Fatalf("preflight without new entries read %d entries", fake.sent()-21)
+	}
+
+	// New entries are read once; a target that became a repeating template
+	// is refused.
+	fake.set(append(entries,
+		map[string]any{NewUUID(): created},
+		map[string]any{id: map[string]any{"e": "Task7", "t": 1, "p": json.RawMessage(`{"rr":{"fu":16},"icsd":1700000000}`)}},
+	))
+	if got := preflightResult(h, id); !strings.Contains(got, "repeating template") {
+		t.Fatalf("preflight = %s", got)
+	}
+	if fake.sent() != 23 {
+		t.Fatalf("read %d entries in total, want 23", fake.sent())
+	}
+
+	// A history shorter than the index (e.g. reset) is read from the start.
+	fake.set(entries[:5])
+	if got := preflightResult(h, id); got != "head 5" {
+		t.Fatalf("after reset: %s", got)
+	}
+
+	// Without KeepPreflightIndex every preflight reads the whole history.
+	KeepPreflightIndex = false
+	before := fake.sent()
+	preflightResult(h, id)
+	preflightResult(h, id)
+	if fake.sent()-before != 10 {
+		t.Fatalf("full scans read %d entries, want 10", fake.sent()-before)
+	}
+}
+
+func TestKeptPreflightIndexIsSeparatePerHistory(t *testing.T) {
+	id := NewUUID()
+	created := map[string]any{"e": "Task7", "t": 0, "p": json.RawMessage(`{"rr":null,"rp":null,"rt":[]}`)}
+	one, two := &fakeHistory{}, &fakeHistory{}
+	one.set([]map[string]any{{id: created}})
+	two.set([]map[string]any{{NewUUID(): created}})
+	first := &History{Client: New(one.server(t).URL, "a@example.com", "pw"), ID: "one"}
+	second := &History{Client: New(two.server(t).URL, "b@example.com", "pw"), ID: "two"}
+	resetPreflightIndex(t, true)
+	if got := preflightResult(first, id); got != "head 1" {
+		t.Fatalf("first history: %s", got)
+	}
+	if got := preflightResult(second, id); !strings.Contains(got, "missing") {
+		t.Fatalf("second history: %s", got)
+	}
+}
+
+// A tombstone in the same history entry as its target's first appearance
+// makes the target ambiguous, whichever of the two is applied first (the
+// entry is a map, so the order varies).
+func TestKeptPreflightIndexTombstoneAtTargetsFirstIndex(t *testing.T) {
+	id := NewUUID()
+	entries := []map[string]any{{
